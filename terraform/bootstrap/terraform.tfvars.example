# Copy to terraform.tfvars (git-ignored). Never put access keys or secrets in here.
region      = "eu-west-2"
github_repo = "your-github-user/skills-radar"

# Refuse to run against the wrong AWS account.
allowed_account_ids = ["123456789012"]

# Optional: a named profile from ~/.aws/config. Leave commented out to use exported environment
# variables such as an MFA session from `aws sts get-session-token`.
# aws_profile = "skillsradar-deploy"

# Optional: assume a role after authenticating.
# assume_role_arn = "arn:aws:iam::123456789012:role/example"

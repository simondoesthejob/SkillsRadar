# Copy to terraform.tfvars (git-ignored) for local runs. CI does not use this file.
# Never put access keys or secrets in here.
region = "eu-west-2"

# Refuse to run against the wrong AWS account.
allowed_account_ids = ["123456789012"]

# Optional: a named profile from ~/.aws/config. Prefer the AWS_PROFILE environment variable so the
# S3 backend uses the same identity, or leave both unset to use exported session credentials.
# aws_profile = "skillsradar-deploy"

# Optional: assume a role after authenticating.
# assume_role_arn = "arn:aws:iam::123456789012:role/example"

# Turn on only after the Adzuna and Reed secrets have been stored.
# ingest_schedule_enabled = true
